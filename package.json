{
  "name": "medipilot-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node dist-api/apps/api/src/index.js",
    "db:generate": "prisma generate",
    "db:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:postgres": "prisma migrate dev --schema prisma/postgresql/schema.prisma",
    "db:migrate:deploy:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test": "DATABASE_URL=file:./test.db prisma db push && DATABASE_URL=file:./test.db tsx prisma/seed.ts && DATABASE_URL=file:./test.db vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prisma": "6.12.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  }
}
