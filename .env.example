DATABASE_URL="file:./dev.db"
# PostgreSQL option: set DATABASE_URL and POSTGRES_PASSWORD to the matching local value.
# DATABASE_URL="postgresql://medipilot:replace-with-a-unique-local-password@localhost:5432/medipilot?schema=public"
POSTGRES_PASSWORD="replace-with-a-unique-local-password"
PORT=4000
NODE_ENV=development
SESSION_SECRET="replace-with-a-long-random-secret-before-deployment"
MAX_UPLOAD_MB=8
UPLOAD_DIRECTORY="private-uploads"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
OCR_PROVIDER="demo"
LLM_PROVIDER="demo"
# Configure real OCR/LLM providers server-side before enabling external processing.
